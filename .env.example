# Copy to `.env` and fill in values.

# Pterodactyl Panel base URL (no trailing slash preferred)
PANEL_URL=https://panel.example.com

# Pterodactyl *Application* API key (admin): typically starts with "ptla_"
# Backs the ptero_app_* / ptero_ai_* tools. Optional if PANEL_CLIENT_TOKEN is set.
PANEL_TOKEN=ptla_REPLACE_ME

# Pterodactyl *Client* API key: typically starts with "ptlc_"
# Backs the ptero_client_* tools (power, console command, status, files, backups).
# Optional. If unset but PANEL_TOKEN is a ptlc_ key, it is reused for the client tools.
# At least one of PANEL_TOKEN / PANEL_CLIENT_TOKEN must be set.
PANEL_CLIENT_TOKEN=ptlc_REPLACE_ME

# Optional
PANEL_TIMEOUT=30
PANEL_VERIFY_SSL=true
PANEL_USER_AGENT=PterodactylMCP/0.1

